# Copia este archivo como .env y completa con los datos de tu proyecto Supabase
# (Supabase > Project Settings > API). Usa SOLO la anon key, nunca la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
# Nombre que aparece en la app y en los mensajes de WhatsApp
VITE_GYM_NAME=Mi Gimnasio
